{
  "kind": "collectionType",
  "collectionName": "e_papers",
  "info": {
    "singularName": "e-paper",
    "pluralName": "e-papers",
    "displayName": "EPaper"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "editionDate": {
      "type": "datetime",
      "required": true
    },
    "editionName": {
      "type": "string"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "description": {
      "type": "text"
    },
    "isFeatured": {
      "type": "boolean",
      "required": false
    }
  }
}
